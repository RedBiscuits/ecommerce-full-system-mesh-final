NODE_ENV=development

# ── Broker ──────────────────────────────────────────────────────────────────
# 'fake' = in-process RabbitMQ (@onify/fake-amqplib; every service in one process
#          shares one broker — the default, used by the tests and the supervisor)
# 'amqp' = a real RabbitMQ at RABBITMQ_URL (required when services run as separate processes)
PLATFORM_BROKER_DRIVER=fake
RABBITMQ_URL=amqp://localhost:5672
# silent | error | warn | info
PLATFORM_LOG_LEVEL=warn
# Set to false to run a service's HTTP API without its integration consumer / outbox relay
INTEGRATION_ENABLED=true

# ── Service-to-service event authentication (shared/security) ───────────────
# enforce (default): every event must be signed by its stream's issuer and addressed to this
# service; permissive: accept unsigned events too (rollout); off: no signing or verification
EVENT_SIGNATURE_MODE=enforce
# Sandbox: all stream keys are derived from this master secret (each service still derives only
# the keys the authorization matrix entitles it to)
EVENT_SIGNING_SECRET=ksa-platform-dev-event-signing-secret
# Production: the keys THIS service was handed (a secrets manager writes it)
# EVENT_SIGNING_KEYS=[{"keyId":"ledger.payment.settled@v2","streamId":"ledger.payment.settled","secret":"..."}]
# Rotation: sign with this key version (verifiers accept every version they hold)
# EVENT_SIGNING_KEY_VERSION=1
# Accept signatures at most this far in the future (clock skew), and optionally refuse old ones
# (0 = no age limit, so DLQ replays stay verifiable)
EVENT_SIGNATURE_CLOCK_SKEW_MS=300000
EVENT_SIGNATURE_MAX_AGE_MS=0

# ── HTTP ports (npm run cluster:supervise -- --serve) ────────────────────────
PAYMENT_GATEWAY_PORT=3101
WALLET_LEDGER_PORT=3102
BILLING_CREDITS_PORT=3103
ZATCA_TAX_PORT=3104
CHECKOUT_COORDINATOR_PORT=3105
# file-cache settlement statements / documents (GET /settlements/:merchantId/:batchId)
FILE_CACHE_PORT=3106

# ── hyperpay-gateway ─────────────────────────────────────────────────────────
# HMAC-SHA256 secret of the webhook signature (required in production)
WEBHOOK_SECRET=change-me
# Merchant (ZATCA taxpayer + ledger revenue account) when customParameters.merchantId is absent
COMMERCE_DEFAULT_MERCHANT_ID=txp_riyadh_retail
# JSON database file
DB_PATH=./db.json

# ── wallet-ledger: merchant settlement sweeps ───────────────────────────────
# Order settlements claimed per chunk (one short transaction each; the event loop is yielded between chunks)
SETTLEMENT_SWEEP_CHUNK_SIZE=500
# Cap on the entries of one batch (the rest of the window goes to the next batch)
SETTLEMENT_MAX_ITEMS_PER_BATCH=100000
# Optional pause between chunks (throttles very large sweeps)
SETTLEMENT_SWEEP_PAUSE_MS=0

# ── billing-credits ──────────────────────────────────────────────────────────
# Value of one credit applied to an order, in halalas (100 = 1.00 SAR)
ORDER_CREDIT_HALALAS_PER_CREDIT=100
ORDER_CREDIT_HOLD_TTL_SECONDS=86400
# Credits restored by a customer refund expire after this many days (when the consumed grants already expired)
ORDER_CREDIT_RESTORE_TTL_DAYS=90
# Real PostgreSQL instead of the embedded PGlite
# DATABASE_URL=postgres://user@localhost:5432/billing

# ── checkout-coordinator (split-tender checkouts) ───────────────────────────
# Standalone service only (the platform / supervisor wires it in-process)
BILLING_CREDITS_URL=http://localhost:3103
WALLET_LEDGER_URL=http://localhost:3102
# JWT of the checkout_coordinator service principal at the wallet ledger
WALLET_SERVICE_TOKEN=
# Both reservations of a checkout are held this long; the credit hold outlives it by the margin
CHECKOUT_RESERVATION_TTL_SECONDS=900
CHECKOUT_CREDIT_HOLD_TTL_MARGIN_SECONDS=300
# Calls to billing / the ledger: attempts on unavailability, jittered backoff, per-call timeout
CHECKOUT_DOWNSTREAM_MAX_ATTEMPTS=4
CHECKOUT_DOWNSTREAM_BASE_DELAY_MS=100
CHECKOUT_DOWNSTREAM_MAX_DELAY_MS=2000
CHECKOUT_DOWNSTREAM_TIMEOUT_MS=5000
# A saga step of a crashed instance is resumed after its lease expired; sweep interval (0 = off)
CHECKOUT_LEASE_MS=30000
CHECKOUT_MAINTENANCE_INTERVAL_MS=10000

# ── zatca-tax ────────────────────────────────────────────────────────────────
# The platform's own taxpayer: seller of the processing service billed at merchant settlement
PLATFORM_TAXPAYER_ID=txp_ksa_platform

# ── file-cache-engine (standalone invoice PDF worker) ────────────────────────
FILE_CACHE_DIR=./.file-cache

# ── tests ────────────────────────────────────────────────────────────────────
# Real-PostgreSQL suites: use this server, or leave unset to let the test run start a
# throwaway cluster when PostgreSQL (initdb / pg_ctl) is installed. TEST_PG=off skips them.
# TEST_DATABASE_URL=postgres://user@localhost:5432/test
# TEST_PG=off
# Parallel runner (npm test): shards run at once (default: CPU count); TEST_NO_RERUN=1 makes a failed file final (no re-run)
# TEST_CONCURRENCY=4
# TEST_NO_RERUN=1
