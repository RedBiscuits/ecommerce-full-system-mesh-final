{
  "name": "ksa-fintech-zatca-commerce-suite",
  "version": "3.0.0",
  "description": "Unified KSA FinTech Commerce, Multi-Currency Wallet Ledger, Striped Billing Credits, File Cache Engine & ZATCA Phase 2 Tax Invoicing Suite",
  "main": "dist/scripts/supervisor.js",
  "scripts": {
    "build": "tsc && tsx scripts/copy-build-assets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"shared/**/*.ts\" \"services/**/*.ts\" \"scripts/**/*.ts\" \"__tests__/**/*.ts\"",
    "test": "tsx scripts/run-tests.ts",
    "tests": "tsx scripts/run-tests.ts",
    "test:serial": "vitest run",
    "test:watch": "vitest",
    "test:platform": "vitest run __tests__/platform __tests__/contracts shared/__tests__",
    "test:shared": "vitest run shared/__tests__",
    "test:hyperpay": "vitest run services/hyperpay-gateway",
    "test:wallet": "vitest run services/wallet-ledger",
    "test:billing": "vitest run services/billing-credits",
    "test:zatca": "vitest run services/zatca-tax",
    "test:file-cache": "vitest run services/file-cache-engine",
    "test:coordinator": "vitest run services/checkout-coordinator",
    "test:pg": "vitest run services/billing-credits/__tests__/postgres-concurrency.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "cluster:topology": "tsx scripts/topology-bootstrap.ts",
    "cluster:doctor": "tsx scripts/cluster-doctor.ts",
    "cluster:supervise": "tsx scripts/supervisor.ts",
    "platform:demo": "tsx scripts/platform-demo.ts",
    "worker:invoice-pdfs": "tsx scripts/invoice-pdf-worker.ts",
    "doctor": "tsx scripts/cluster-doctor.ts",
    "topology:bootstrap": "tsx scripts/topology-bootstrap.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@onify/fake-amqplib": "^3.7.0",
    "amqplib": "^0.10.4",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.9.0",
    "jose": "^5.6.3",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "tslib": "^2.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8.2.3",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
